# Copy to /etc/meeting-analysis/.env and set owner root:root, mode 0600.
# Fill secret values on the server; never commit the populated file.
OPENAI_API_KEY=replace-on-server
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6-luna
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
APP_SECRET_KEY=generate-a-long-random-value-on-server
